# Copy this file to `.env` and fill in your own values, then load it before
# running the app, e.g.:   set -a; source .env; set +a; python3 app.py
#
# None of these are committed -- .env is git-ignored.

# --- Flask ---------------------------------------------------------------
# Secret key for signing session/flash cookies. Use any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Optional: where the SQLite file lives (defaults to ./schedule.db)
# SCHEDULE_DB=/absolute/path/to/schedule.db

# Optional: port for the web server (defaults to 5000)
# PORT=5000

# --- Email (SMTP) --------------------------------------------------------
# Example for Gmail: create an "App password" (with 2FA on) and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# Optional "From" address; defaults to SMTP_USER
# SMTP_FROM=you@gmail.com
# Set to true only if your provider needs implicit SSL (port 465)
# SMTP_USE_SSL=false

# --- SMS (Twilio) --------------------------------------------------------
# From your Twilio console. FROM_NUMBER must be a Twilio number you own,
# in E.164 format (e.g. +15551234567). Recipient phone numbers should also
# be in E.164 format.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15551234567
